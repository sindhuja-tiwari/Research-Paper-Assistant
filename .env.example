# Copy this file to .env and fill in your key.
# Only the LLM calls (generation + agent tool-calling) need this.
# Embeddings and re-ranking run locally via sentence-transformers, so they're free.
OPENAI_API_KEY=sk-your-key-here

# Optional: a contact email sent in the User-Agent to arXiv, as their API terms request.
# ARXIV_CONTACT_EMAIL=you@example.com
